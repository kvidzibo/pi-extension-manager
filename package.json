{
  "name": "@kvidzibo/pi-extension-manager",
  "version": "1.1.0",
  "description": "Inspect Pi extension context, tool definitions, and estimated token contributions.",
  "type": "module",
  "license": "MIT",
  "author": "Tomas Rackauskas",
  "keywords": [
    "pi-package",
    "extensions",
    "context",
    "tokens"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvidzibo/pi-extension-manager.git"
  },
  "homepage": "https://github.com/kvidzibo/pi-extension-manager#readme",
  "bugs": {
    "url": "https://github.com/kvidzibo/pi-extension-manager/issues"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
